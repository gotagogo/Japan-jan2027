{"cfg": {"bbox": [140.826, 40.668, 140.866, 40.69], "b0": 540.0, "key": "hakkoda", "top": [140.8587978, 40.6758975], "base": [140.8318779, 40.6808663], "tgt": [140.846, 40.678, 983.4116372508327]}, "T": {"ja": {"title": "八甲田スキー場（八甲田ロープウェー）3D ゲレンデマップ（非公式）", "elev": "標高は国土地理院DEM5Aによる概算（ロープウェー山頂公園駅 約1304m／山麓駅 約663m／標高差 約641m）。公式：田茂萢岳 1,324m。", "dag": "公式マップではありません。公式管理コースはダイレクト・フォレストの2本で、どちらも非圧雪・中〜上級（公式サイト）。コース線はOpenStreetMap。紫の範囲は非圧雪コース全体を示す概略です。ツアールート・バックカントリーは管理区域外のため描いていません。ふもとのリフトは隣の八甲田国際スキー場（別施設）。† 非公式名称。", "ng2": "⚠ 公式マップの「×危険区域（絶対に立ち入らないで下さい）」：田茂萢沢・寒水沢。赤斜線は公式マップから推定した概略位置です。コースはオレンジのポールに沿って滑走してください。管理区域外での救助は有料（八甲田ルール）。", "src": "地形：国土地理院 DEM5A・写真：国土地理院・リフト／コース：OpenStreetMap・コース名：公式サイト（位置は推定）", "nogoL": "危険区域（立入禁止・推定位置）", "g": "初級", "r": "中級", "bk": "上級", "lift": "リフト", "old": "", "est": "位置は概略", "zl": "エリア表示", "zon": "エリア：表示中", "zoff": "エリア：非表示", "zest": "範囲は概略", "hint": "ドラッグで左右に回転・スクロール／ピンチでズーム", "show": "名称を表示", "hide": "名称を非表示", "top": "山頂 約1304m", "base": "ベース 約663m", "vd": "標高差 約641m", "tr": "ツリーラン", "pw": "非圧雪（パウダー）", "pk": "スノーパーク", "nogo": ""}, "zh": {"title": "八甲田滑雪場（八甲田纜車）3D 雪場圖（非官方）", "elev": "標高為依國土地理院 DEM5A 估算（纜車山頂公園站 約1304m／山麓站 約663m／落差 約641m）。官方：田茂萢岳 1,324m。", "dag": "非官方地圖。官方管理的滑道只有直降（Direct）和森林（Forest）兩條，皆為非壓雪、中～上級（官網）。滑道線取自 OpenStreetMap，紫色範圍是整條非壓雪滑道的概略範圍。登山滑雪路線（Tour route）和野雪屬於管理區域外，未繪出。山腳的吊椅屬隔壁的八甲田國際滑雪場（不同設施）。† 非官方名稱，為本站翻譯。", "ng2": "⚠ 官方地圖標示的「× 危險區域（絕對禁止進入）」：田茂萢澤、寒水澤。紅色斜線是依官方地圖推定的概略位置。請沿橘色標竿在滑道內滑行；管理區域外的救援會收費（八甲田規則）。", "src": "地形：國土地理院 DEM5A・影像：國土地理院・纜車／滑道：OpenStreetMap・名稱：官網（位置為推定）", "nogoL": "危險區域（禁止進入・推定位置）", "g": "初級", "r": "中級", "bk": "上級", "lift": "纜車", "old": "", "est": "位置為概略", "zl": "區域", "zon": "區域：顯示", "zoff": "區域：隱藏", "zest": "範圍為概略", "hint": "拖曳左右旋轉・滾輪／雙指縮放", "show": "顯示名稱", "hide": "隱藏名稱", "top": "山頂 約1304m", "base": "山腳 約663m", "vd": "落差 約641m", "tr": "樹林滑行區", "pw": "非壓雪（粉雪）", "pk": "雪地公園", "nogo": ""}, "en": {"title": "Hakkoda Ski Area (Hakkoda Ropeway) 3D Map (unofficial)", "elev": "Elevations measured from GSI DEM5A (rop